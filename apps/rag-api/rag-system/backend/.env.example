# ─── RAG Backend Environment Configuration ───────────────────────────────────

# ChromaDB storage path (persistent)
CHROMA_PATH=./chroma_db

# Collection name in ChromaDB
COLLECTION_NAME=rag_documents

# SentenceTransformer embedding model (auto-downloaded on first run)
EMBED_MODEL=all-MiniLM-L6-v2

# ─── FREE LLM APIs (at least one required) ────────────────────────────────────

# Option 1: Groq API (RECOMMENDED - fastest free tier)
# Sign up at https://console.groq.com → free 14,400 tokens/min
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192

# Option 2: HuggingFace Inference API (fallback)
# Sign up at https://huggingface.co → Settings → Access Tokens (free)
HF_API_KEY=your_hf_api_key_here
HF_MODEL=mistralai/Mistral-7B-Instruct-v0.2

# ─── RAG Parameters ───────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
TOP_K=5
MAX_TOKENS=1024

# ─── CORS (comma-separated allowed origins) ───────────────────────────────────
ALLOWED_ORIGINS=http://localhost,http://localhost:8080,http://127.0.0.1:8080
